# Database
DATABASE_URL=postgres://margin:margin@localhost:5432/margin

# Identity Provider
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:5173/callback
OIDC_ISSUER_URL=

# Session
SESSION_SECRET=change-me-to-a-random-64-char-string
SESSION_MAX_LIFETIME_HOURS=720

# App
APP_BASE_URL=http://localhost:5173

# Email Provider
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@margin.app

# Reminder Policy
REMINDER_SNOOZE_LIMIT=5
REMINDER_MAX_RETRIES=3
REMINDER_RETRY_BASE_MINUTES=15
REMINDER_DAILY_RETRY_WINDOW_START_HOUR=8
REMINDER_DAILY_RETRY_WINDOW_END_HOUR=22

# Timezone
DEFAULT_TIMEZONE=UTC

# Hatchet
HATCHET_CLIENT_TOKEN=
